<!DOCTYPE html>
<html lang="@Ui.Culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@($"favicon.svg?v={Wire.Version}")" />
    <link rel="stylesheet" href="app.css" />
    <script src="app.js"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <div id="blazor-error-ui" role="alert">
        @Ui["Connection interrupted."] <a href="">@Ui["Reload EndpointControl"]</a>
        <button class="dismiss" aria-label="@Ui["Dismiss"]">×</button>
    </div>
</body>
</html>
@code
{
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private Microsoft.AspNetCore.Components.IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
