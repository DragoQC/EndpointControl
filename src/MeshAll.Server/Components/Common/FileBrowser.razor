@inherits PageBase
@inject IJSRuntime JS
<Notice Error="@Error" Success="@Success" />
<section class="panel"><div class="panel-header"><div><h2>File manager</h2><p>Browse, upload, and download files. Up to 5 MB per transfer.</p></div><div class="inline-actions">@if(Can(Permissions.FilesWrite)){<label class="button upload-button"><Icon Name="plus" />Upload file<InputFile OnChange="Upload" disabled="@Busy" /></label>}</div></div>
<form class="file-path" @onsubmit="Navigate" @onsubmit:preventDefault><button type="button" class="button small" disabled="@(Busy || listing?.Parent is null)" @onclick="Up">Up</button><input @bind="path" aria-label="Remote path" placeholder="Agent file root" /><button class="button small" disabled="@Busy">Open path</button></form>
<div class="folder-create">@if(Can(Permissions.FilesWrite)){<input @bind="folderName" placeholder="New folder name" aria-label="New folder name" maxlength="150" /><button class="button small" disabled="@Busy" @onclick="CreateFolder">Create folder</button>}<span class="muted small-text">@listing?.Entries.Length items</span></div>
@if (listing is null) { <EmptyState Icon="folder" Title="Open the remote filesystem" Text="Choose Open path to browse the agent’s configured file root." /> }
else { <div class="table-scroll"><table><thead><tr><th>Name</th><th>Size</th><th>Modified</th><th></th></tr></thead><tbody>@foreach (var f in listing.Entries) { <tr><td><span class="file-name"><Icon Name="@(f.Directory ? "folder" : "file")" />@if (f.Directory) { <button class="link-button" @onclick="() => OpenFolder(f.Path)">@f.Name</button> } else { <strong>@f.Name</strong> }</span></td><td>@(f.Directory ? "Folder" : Bytes(f.Size))</td><td class="muted">@f.Modified.ToLocalTime().ToString("g")</td><td><div class="inline-actions">@if (!f.Directory) { <a class="text-link" href="@($"/api/devices/{DeviceId}/file?path={Uri.EscapeDataString(f.Path)}")" download>Download</a> }@if(Can(Permissions.FilesWrite)){<button class="link-button danger-text" disabled="@Busy" @onclick="() => Delete(f)">Delete</button>}</div></td></tr> }</tbody></table></div>@if (listing.Entries.Length == 0) { <EmptyState Icon="folder" Title="An empty folder" Text="Upload a file or create a folder to get started." /> } }
</section>
@code {
    [Parameter] public string DeviceId { get; set; } = "";
    protected override string? ViewPermission => Permissions.FilesRead;
    private string path = "", folderName = ""; private FileListing? listing;
    private Task Navigate() => Act(async () => { listing = await Workspace.RunAsync<FileListing>(DeviceId, "files.list", new FileInput(path)); path = listing.Path; });
    private async Task OpenFolder(string value) { path = value; await Navigate(); }
    private async Task Up() { if (listing?.Parent is { } parent) await OpenFolder(parent); }
    private string Combine(string name) => (listing?.Path ?? path).TrimEnd('/', '\\') + "/" + name;
    private Task CreateFolder() => Act(async () => {
        CheckName(folderName); await Workspace.RunAsync<string>(DeviceId, "files.mkdir", new FileInput(Combine(folderName))); folderName = "";
        listing = await Workspace.RunAsync<FileListing>(DeviceId, "files.list", new FileInput(path)); path = listing.Path;
    }, "Folder created.");
    private Task Upload(InputFileChangeEventArgs e) => Act(async () => {
        var file = e.File; CheckName(file.Name);
        using var stream = new MemoryStream(); await file.OpenReadStream(Wire.MaxFileBytes).CopyToAsync(stream);
        await Workspace.RunAsync<string>(DeviceId, "files.write", new FileInput(Combine(file.Name), Convert.ToBase64String(stream.ToArray())));
        listing = await Workspace.RunAsync<FileListing>(DeviceId, "files.list", new FileInput(path)); path = listing.Path;
    }, "File uploaded.");
    private async Task Delete(RemoteFile f) {
        if (await JS.InvokeAsync<bool>("confirm", $"Delete {f.Name}? Folders must be empty.")) await Act(async () => {
            await Workspace.RunAsync<string>(DeviceId, "files.delete", new FileInput(f.Path));
            listing = await Workspace.RunAsync<FileListing>(DeviceId, "files.list", new FileInput(path));
        }, "Item deleted.");
    }
    private static void CheckName(string name) { if (string.IsNullOrWhiteSpace(name) || name.IndexOfAny(['/', '\\']) >= 0 || name is "." or "..") throw new InvalidOperationException("Enter a file or folder name without a path."); }
}
