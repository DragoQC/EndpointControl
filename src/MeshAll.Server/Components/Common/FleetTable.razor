@inject AgentGateway Gateway
<div class="table-scroll"><table class="fleet-table"><thead><tr><th>Device</th><th>Status</th><th>Operating system</th><th>Group</th><th>Last seen</th><th><span class="sr-only">Actions</span></th></tr></thead>
<tbody>@foreach (var device in Items) {
    <tr @key="device.Id"><td><a class="device-link" href="@($"/devices/{device.Id}")"><span class="device-symbol @(device.Inventory?.Platform == "Windows" ? "blue" : "slate")"><Icon Name="@(device.Inventory?.Platform == "Windows" ? "windows" : "server")" /></span><span><strong>@device.Name</strong><small>@(device.Inventory?.Ip ?? "Awaiting inventory")</small></span></a></td>
    <td><span class="status @(device.Disabled ? "revoked" : Gateway.Online(device.Id) ? "online" : "offline")"><span class="status-dot"></span>@(device.Disabled ? "Revoked" : Gateway.Online(device.Id) ? "Online" : "Offline")</span></td>
    <td><span>@(device.Inventory?.Platform ?? "Pending")</span><small class="os-detail">@(device.Inventory?.Architecture ?? "—")</small></td>
    <td><span class="group-pill">@(Groups.FirstOrDefault(g => g.Id == device.GroupId)?.Name ?? "Unassigned")</span></td>
    <td class="muted">@(Gateway.Online(device.Id) ? "Connected now" : Relative(device.LastSeen))</td>
    <td><a class="row-action" href="@($"/devices/{device.Id}")" aria-label="@($"Open {device.Name}")"><Icon Name="arrow" /></a></td></tr>
}</tbody></table></div>
@code {
    [Parameter] public IEnumerable<DeviceInfo> Items { get; set; } = [];
    [Parameter] public List<GroupInfo> Groups { get; set; } = [];
    private static string Relative(DateTimeOffset time) { if (time <= DateTimeOffset.UnixEpoch) return "Not reported"; var t = DateTimeOffset.UtcNow-time; return t.TotalMinutes < 1 ? "Just now" : t.TotalHours < 1 ? $"{(int)t.TotalMinutes}m ago" : t.TotalDays < 1 ? $"{(int)t.TotalHours}h ago" : $"{(int)t.TotalDays}d ago"; }
}
