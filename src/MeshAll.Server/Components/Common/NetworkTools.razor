@inherits PageBase

@foreach ((string Title, bool Native) category in Categories)
{
    RemoteToolInfo[] available = Tools.Where(tool => tool.Native == category.Native && Can(Permissions.ForTool(tool.Id))).ToArray();
    @if (available.Length > 0)
    {
        <section class="remote-tool-category" aria-label="@Ui[category.Title]">
            <h2>@Ui[category.Title]</h2>
            <div class="network-tools-grid">
                @foreach (RemoteToolInfo tool in available)
                {
                    <button type="button" class="panel remote-tool-card" aria-pressed="@(selected == tool.Id ? "true" : "false")" @onclick="() => SelectTool(tool.Id)">
                        <span class="stat-icon @(tool.Native ? "teal" : "blue")"><Icon Name="@tool.Icon" /></span>
                        <span class="remote-tool-copy"><strong>@Ui[tool.Name]</strong><span class="muted small-text">@Ui[tool.Description]</span></span>
                    </button>
                }
            </div>
        </section>
    }
}
@if (selected is not null)
{
    <div class="inline-actions mb-4">
        <a class="text-link" href="@($"/remote/{DeviceId}/{selected}")" target="_blank" rel="noopener">@Ui["Open in new tab"]</a>
        <button class="link-button" @onclick="() => selected = null">@Ui["Close"]</button>
    </div>
    <RemoteViewer Id="@DeviceId" Tool="@selected" Inline="true" AutoConnect="@(selected == "desktop")" @key="selected" />
}

@code
{
    [Parameter]
    public string DeviceId { get; set; } = "";

    private string? selected;
    private void SelectTool(string tool) => selected = tool;

    private sealed record RemoteToolInfo(string Id, string Name, string Description, string Icon, bool Native);

    private static readonly (string Title, bool Native)[] Categories = [("Native tools", true), ("Network services", false)];
    private static readonly RemoteToolInfo[] Tools =
    [
        new("desktop", "Agent desktop", "Native desktop access.", "monitor", true),
        new("terminal", "Interactive terminal", "Agent terminal.", "terminal", true),
        new("powershell", "PowerShell terminal", "Agent PowerShell terminal.", "terminal", true),
        new("rdp", "Remote Desktop (RDP)", "Requires RDP on the device.", "windows", false),
        new("vnc", "VNC", "Requires an existing VNC service.", "monitor", false),
        new("ssh", "SSH", "Requires SSH on the device.", "terminal", false),
        new("amt", "Intel AMT KVM", "Requires configured Intel AMT.", "server", false)
    ];
}
