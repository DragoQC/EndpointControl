@inherits PageBase

<AuthorizeView Policy="@Permissions.Rdp">
<Authorized>
<section id="rdp-credentials" class="panel editor-panel">
    <h2>@Ui["Your RDP credentials"]</h2>
    <p class="muted">@Ui["Used to prefill RDP connections for your account."]</p>
    <Notice Error="@Error" Success="@Success" />
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <fieldset class="connection-preferences-fields" disabled="@(!ready || Busy)">
            <label>@Ui["Domain"]<input @bind="domain" maxlength="256" autocomplete="off" /></label>
            <label>@Ui["Username"]<input @bind="username" maxlength="256" required autocomplete="off" /></label>
            <label>@Ui["Password"]<input @bind="password" type="password" maxlength="512" autocomplete="new-password" /></label>
            <div class="form-actions">
                @if (hasDefaults)
                {
                    <button type="button" class="button" @onclick="ClearAsync">@Ui["Clear saved credentials"]</button>
                }
                <button class="button primary">@Ui["Save RDP credentials"]</button>
            </div>
        </fieldset>
    </form>
</section>
</Authorized>
</AuthorizeView>

@code
{
    protected override string? ViewPermission => Permissions.Rdp;
    protected override string? ChangePermission => Permissions.Rdp;

    private string domain = "";
    private string username = "";
    private string password = "";
    private bool ready;
    private bool hasDefaults;

    protected override Task LoadAsync()
    {
        if (!ready && CurrentUser is not null)
        {
            RdpDefaultsSummary? defaults = Store.RdpDefaults(CurrentUser);
            domain = defaults?.Domain ?? "";
            username = defaults?.Username ?? "";
            hasDefaults = defaults is not null;
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender || CurrentUser is null)
        {
            return;
        }

        // OnAfterRender does not run during prerender: passwords are sent only
        // to the authenticated interactive editor, never in the initial HTML.
        await Act(() =>
        {
            RdpCredentials? credentials = Store.ReadRdpCredentials(CurrentUser);
            password = credentials?.Password ?? "";
        }, permission: Permissions.Rdp);
        ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task SaveAsync() => Act(() =>
    {
        Store.SaveRdpCredentials(CurrentUser!, domain, username, password);
        hasDefaults = true;
    }, "RDP credentials saved.");

    private Task ClearAsync() => Act(() =>
    {
        Store.ClearRdpCredentials(CurrentUser!);
        domain = username = password = "";
        hasDefaults = false;
    }, "Saved RDP credentials cleared.");

    public override async ValueTask DisposeAsync()
    {
        password = "";
        await base.DisposeAsync();
    }
}
