@inject NavigationManager Navigation
@inject Store Store
<p>@Ui["Opening sign-in…"] <a href="/login">@Ui["Continue"]</a></p>
@code
{
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo(Store.HasUsers ? "/login" : "/setup", forceLoad: true);
        }
    }
}
