<section class="remote-workspace @(Inline ? "remote-inline panel" : "")" data-remote-workspace @ref="workspace">
    <div class="remote-toolbar">
        <div class="remote-title">
            <h2>@Ui[Label] <span class="muted">/ @device?.Name</span></h2>
            <p class="muted small-text" role="status">@Ui.Message(status)</p>
        </div>
        <div class="remote-actions">
            @if (Tool is "desktop" or "amt" && running)
            {
                <label class="checkbox-label">
                    <input type="checkbox" @bind="control" @bind:after="SetControlAsync" disabled="@(!canControl || !inputAvailable)" />
                    @Ui["Enable keyboard & mouse"]
                </label>
                <button class="button small" @onclick="SendCtrlAltDeleteAsync" disabled="@(!canControl || !inputAvailable || !control)">@Ui["Ctrl+Alt+Delete"]</button>
            }
            <RemoteFullscreenButton />
            @if (running)
            {
                <button class="button danger small" @onclick="DisconnectAsync">@Ui["Disconnect"]</button>
            }
            else
            {
                <button class="button primary small" disabled="@(busy || !ready)" @onclick="ConnectAsync"><Icon Name="monitor" />@Ui["Connect"]</button>
            }
            @if (!Inline)
            {
                <a class="button small" href="@($"/devices/{Id}")" target="_top">@Ui["Back to device"]</a>
            }
        </div>
    </div>
    <Notice Error="@error" />
    <div class="notice error remote-fullscreen-error" data-remote-fullscreen-error role="alert" hidden>
        @Ui["Fullscreen could not be changed. Try again or press Escape to exit fullscreen."]
    </div>
    @if (!running && Tool is ("rdp" or "ssh"))
    {
        <form class="panel editor-panel remote-setup" @onsubmit="ConnectAsync" @onsubmit:preventDefault>
            <fieldset class="remote-connection-fields" disabled="@(!ready || busy)">
                <div class="form-grid">
                    <label>@Ui["Remote port"]<input type="number" @bind="port" min="1" max="65535" /></label>
                    @if (Tool == "rdp")
                    {
                        <label>@Ui["Domain"]<input @bind="domain" autocomplete="off" /></label>
                    }
                    <label>@Ui["Username"]<input @bind="username" autocomplete="off" /></label>
                    <label>@Ui["Password"]<input @bind="password" type="password" autocomplete="off" /></label>
                </div>
                @if (Tool == "ssh")
                {
                    <label>@Ui["Private key (optional)"]
                        <textarea @bind="privateKey" rows="3" class="code-input" maxlength="16000" autocomplete="off"></textarea>
                        <small>@Ui["Password is used as the key passphrase when a key is provided."]</small>
                    </label>
                }
                @if (Tool == "rdp")
                {
                    <a class="text-link" href="/account/security#rdp-credentials" data-enhance-nav="false">@Ui["Manage your RDP credentials"]</a>
                }
                <label class="checkbox-label"><input type="checkbox" @bind="direct" />@Ui["Connect directly to {0}", device?.Inventory?.Ip ?? ""]</label>
                <p class="muted small-text">@Ui["Direct access requires the service to be reachable from the server."]</p>
            </fieldset>
        </form>
    }
    @if (Tool == "vnc" && !running)
    {
        <section class="panel editor-panel remote-setup">
            <h2>@Ui["Agent-assisted VNC"]</h2>
            <p class="muted">@Ui["Requires an existing VNC service."]</p>
            <details class="mt-4">
                <summary>@Ui["Connection settings"]</summary>
                <label class="mt-3">@Ui["Remote port"]<input type="number" @bind="port" min="1" max="65535" /></label>
                <label class="checkbox-label"><input type="checkbox" @bind="direct" />@Ui["Connect directly from the orchestrator"]</label>
            </details>
        </section>
    }
    @if (Tool == "vnc" && vncNeedsCredentials)
    {
        <form class="panel editor-panel remote-setup" @onsubmit="SubmitVncCredentialsAsync" @onsubmit:preventDefault>
            <h2>@Ui["VNC authentication"]</h2>
            <p class="muted">@Ui["The VNC service requested authentication."]</p>
            @if (vncNeedsUsername)
            {
                <label>@Ui["VNC username"]<input @bind="username" autocomplete="off" required maxlength="256" /></label>
            }
            @if (vncNeedsPassword)
            {
                <label>@Ui["VNC password"]<input type="password" @bind="password" autocomplete="off" required maxlength="256" /></label>
            }
            <button type="submit" class="button primary">@Ui["Continue"]</button>
        </form>
    }
    <div class="remote-surface" style="@(running ? "" : "display:none")">
        <canvas id="remote-canvas" tabindex="0" aria-label="@Ui["Remote display"]"></canvas>
        <div id="remote-terminal"></div>
        <div id="remote-vnc"></div>
    </div>
</section>
