@inherits LayoutComponentBase
@inject Store Store
@inject IConfiguration Config
@inject IJSRuntime JS
<a class="skip-link" href="#main-content">Skip to content</a>
<span class="sr-only" data-meshall-ready="@ready.ToString().ToLowerInvariant()" aria-hidden="true"></span>
<header class="topbar text-white">
    <div class="shell topbar-inner">
        <a href="/" class="brand"><span class="brand-mark">m</span>MeshAll<span class="brand-dot">.</span></a>
        <span class="workspace-label">@Store.Setting("siteName", Config["MeshAll:SiteName"] ?? "My workspace")</span>
        <div class="topbar-actions">
            <button class="theme-button" @onclick="ToggleTheme" aria-label="Toggle light or dark theme"><Icon Name="sun" /></button>
            <AuthorizeView><Authorized Context="auth"><span class="avatar">@auth.User.Identity?.Name?[..1].ToUpperInvariant()</span><span class="account-name">@auth.User.Identity?.Name</span></Authorized></AuthorizeView>
            <form method="post" action="/auth/logout" data-enhance="false"><AntiforgeryToken /><button class="signout" type="submit">Sign out</button></form>
        </div>
    </div>
</header>
<nav class="main-nav" aria-label="Main navigation"><div class="shell nav-inner">
    <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="grid" />Overview</NavLink>
    <NavLink href="/devices"><Icon Name="monitor" />Devices</NavLink>
    <NavLink href="/groups"><Icon Name="layers" />Device groups</NavLink>
    <AuthorizeView Roles="Admin,Operator"><NavLink href="/scripts"><Icon Name="terminal" />Scripts</NavLink></AuthorizeView>
    <NavLink href="/sessions"><Icon Name="activity" />Sessions</NavLink>
    <AuthorizeView Roles="Admin"><NavLink href="/users"><Icon Name="users" />Users</NavLink></AuthorizeView>
    <NavLink href="/audit"><Icon Name="clock" />Audit log</NavLink>
    <AuthorizeView Roles="Admin"><NavLink href="/settings"><Icon Name="settings" />Settings</NavLink></AuthorizeView>
</div></nav>
<main id="main-content" class="shell main-content mx-auto w-full">@Body</main>
<footer class="shell footer"><span><span class="tiny-brand">m</span> MeshAll <span class="muted">@Wire.Version</span></span><span>Built with .NET 10 <span class="footer-dot">•</span> Self-hosted, by you</span></footer>
@code {
    private bool ready;
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { ready = true; StateHasChanged(); } }
    private async Task ToggleTheme() => await JS.InvokeVoidAsync("meshAll.toggleTheme");
}
