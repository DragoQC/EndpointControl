@inherits LayoutComponentBase
@inject Store Store

<a class="skip-link" href="#main-content">@Ui["Skip to content"]</a>
<span class="sr-only" data-meshall-ready="@ready.ToString().ToLowerInvariant()" aria-hidden="true"></span>
<header class="topbar text-white">
    <div class="shell topbar-inner">
        <a href="/" class="brand"><BrandMark />@ProductBrand.Name</a>
        <div class="topbar-actions">
            <LanguageSwitcher />
            <button class="theme-button" type="button" data-theme-toggle aria-label="@Ui["Toggle light or dark theme"]">
                <Icon Name="sun" />
            </button>
            <AuthorizeView>
                <Authorized Context="authentication">
                    <span class="avatar">@authentication.User.Identity?.Name?[..1].ToUpperInvariant()</span>
                    <a class="account-name" href="/account/security" data-enhance-nav="false">@authentication.User.Identity?.Name</a>
                </Authorized>
            </AuthorizeView>
            <form method="post" action="/auth/logout" data-enhance="false">
                <AntiforgeryToken />
                <button class="signout" type="submit">@Ui["Sign out"]</button>
            </form>
        </div>
    </div>
</header>

<nav class="main-nav" aria-label="@Ui["Main navigation"]">
    <div class="shell nav-inner">
        <AuthorizeView Policy="@Permissions.Inventory">
            <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="grid" />@Ui["Dashboard"]</NavLink>
            <NavLink href="/devices"><Icon Name="monitor" />@Ui["Devices"]</NavLink>
            <NavLink href="/groups"><Icon Name="layers" />@Ui["Device groups"]</NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.Scripts">
            <NavLink href="/scripts"><Icon Name="terminal" />@Ui["Scripts"]</NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.LogsPolicy">
            <NavLink href="/logs"><Icon Name="activity" />@Ui["Logs"]</NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.Users">
            <NavLink href="/users"><Icon Name="users" />@Ui["Users"]</NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.Roles">
            <NavLink href="/roles"><Icon Name="shield" />@Ui["Roles"]</NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.Settings">
            <NavLink href="/settings"><Icon Name="settings" />@Ui["App settings"]</NavLink>
        </AuthorizeView>
        <NavLink href="/account/security" data-enhance-nav="false"><Icon Name="shield" />@Ui["Security"]</NavLink>
    </div>
</nav>

<main id="main-content" class="shell main-content mx-auto w-full">@Body</main>
<footer class="shell footer">
    <span class="footer-brand"><BrandMark CssClass="tiny-brand" /> @ProductBrand.Name <span class="muted">@Wire.Version</span></span>
    <a class="text-link" href="/compatibility">@Ui["About"]</a>
</footer>

@code
{
    private bool ready;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ready = true;
            StateHasChanged();
        }
    }
}
