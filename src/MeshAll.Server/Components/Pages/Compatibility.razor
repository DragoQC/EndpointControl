@page "/compatibility"
@attribute [Authorize]
@inherits PageBase

<PageTitle>@Ui["About"] · @ProductBrand.Name</PageTitle>
<PageHeader Title="About EndpointControl" />

<section class="panel">
    <div class="panel-header">
        <div><h2>@Ui["Components"]</h2></div>
    </div>
    <DataTable Items="Architecture" Label="Architecture components" ItemKey="component => component.Name">
        <Header><th>@Ui["Component"]</th><th>@Ui["Technology"]</th><th>@Ui["Source"]</th></Header>
        <RowTemplate Context="component">
            <td>@Ui[component.Name]</td><td>@Ui[component.Technology]</td><td><code>@component.Source</code></td>
        </RowTemplate>
    </DataTable>
</section>
<section class="panel editor-panel">
    <h2>@Ui["Verification"]</h2>
    <p class="muted">@Ui["Feature verification details:"] <code>docs/COMPATIBILITY.md</code></p>
</section>
<section class="panel editor-panel">
    <h2>@Ui["Licensing"]</h2>
    <p class="muted">@Ui["License information:"] <code>THIRD_PARTY_NOTICES.md</code></p>
</section>

@code
{
    private sealed record ComponentInfo(string Name, string Technology, string Source);
    private static readonly ComponentInfo[] Architecture = [new("Orchestration and management", "ASP.NET Core / C# / SQLite", "src/MeshAll.Server"), new("Management UI", "Blazor Server + Tailwind", "Components/ and Styles/"), new("Native PC agent", "C/C++ and agent-side JavaScript", "components/agent-native, agent-core"), new("Desktop and AMT viewers", "Retained browser protocol components", "components/viewers"), new("Terminal / VNC / RDP rendering", "Declared, licensed rendering dependencies", "xterm.js / noVNC / Guacamole")];
}
