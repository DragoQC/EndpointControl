@page "/devices/{Id}"
@attribute [Authorize(Policy = Permissions.Inventory)]
@inherits PageBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@(device?.Name ?? Ui["Device"]) · @ProductBrand.Name</PageTitle>
<Notice Error="@Error" Success="@Success" />

@if (device is not null)
{
    <div class="page-heading">
        <div>
            <div class="breadcrumb"><a href="/devices">@Ui["Devices"]</a> / @device.Name</div>
            <div class="device-title">
                <span class="device-symbol large blue"><Icon Name="@(device.Inventory?.Platform == "Windows" ? "windows" : "server")" /></span>
                <div><h1>@device.Name</h1><p class="muted">@device.Inventory?.Os</p></div>
                <span class="status @(online ? "online" : "offline")">
                    <span class="status-dot"></span>@Ui[device.Disabled ? "Blocked" : online ? "Online" : "Offline"]
                </span>
            </div>
        </div>
        <div class="inline-actions">
            @if (online)
            {
                <button class="button" disabled="@Busy" @onclick="RefreshInventory">@Ui["Refresh inventory"]</button>
            }
            @if (Can(Permissions.EditDevices) && !device.Disabled)
            {
                <button class="button" @onclick="EditDevice"><Icon Name="settings" />@Ui["Edit device"]</button>
            }
        </div>
    </div>

    @if (editing)
    {
        <section class="panel editor-panel">
            <h2>@Ui["Device settings"]</h2>
            <form @onsubmit="SaveDevice" @onsubmit:preventDefault>
                <div class="form-grid">
                    <label>@Ui["Display name"]<input @bind="name" maxlength="100" required /></label>
                    <label>@Ui["Device group"]
                        <SelectField TValue="string" Expand="true" @bind-Value="group">
                            @foreach (GroupInfo item in groups)
                            {
                                <option value="@item.Id">@Ui.GroupName(item.Name, item.Id)</option>
                            }
                        </SelectField>
                    </label>
                    <label>@Ui["Tags"]<input @bind="tags" maxlength="300" /></label>
                    <label>@Ui["Notes"]<textarea @bind="notes" maxlength="4000" rows="2"></textarea></label>
                </div>
                <div class="form-actions">
                    <button type="button" class="button" @onclick="() => editing = false">@Ui["Cancel"]</button>
                    <button class="button primary" disabled="@Busy">@Ui["Save changes"]</button>
                </div>
            </form>
        </section>
    }

    <div class="tab-bar" role="navigation" aria-label="@Ui["Device views"]">
        @foreach (string item in Tabs.Where(Allowed))
        {
            <button class="@(tab == item ? "active" : "")" @onclick="() => SelectTab(item)">@Ui[item]</button>
        }
    </div>

    @if (!Allowed(tab))
    {
        <EmptyState Icon="shield" Title="Capability not granted" Text="Your role does not grant this capability." />
    }
    else if (tab == "Overview")
    {
        @if (device.Inventory is Inventory inventory)
        {
            @if (!string.IsNullOrWhiteSpace(inventory.Diagnostic))
            {
                <Notice Error="@inventory.Diagnostic" />
            }
            <DeviceResourceStats Inventory="inventory" Online="online" />
            <div class="device-overview">
                <section class="panel editor-panel">
                    <h2>@Ui["Device information"]</h2>
                    <dl class="details-grid">
                        <dt>@Ui["Hostname"]</dt><dd>@Reported(inventory.Hostname)</dd>
                        <dt>@Ui["Operating system"]</dt><dd>@Reported(inventory.Os)</dd>
                        <dt>@Ui["Architecture"]</dt><dd>@Reported(inventory.Architecture)</dd>
                        <dt>@Ui["Signed-in user"]</dt><dd>@(string.IsNullOrWhiteSpace(inventory.Username) ? Ui["No active user"] : inventory.Username)</dd>
                        <dt>@Ui["Primary IP address"]</dt><dd>@Reported(inventory.Ip)</dd>
                        <dt>@Ui["MAC address"]</dt><dd>@Reported(inventory.Mac)</dd>
                        <dt>@Ui["Connection address"]</dt><dd>@Reported(inventory.ConnectionAddress)</dd>
                        <dt>@Ui["CPU model"]</dt><dd>@Reported(inventory.CpuModel)</dd>
                        <dt>@Ui["Logical CPU cores"]</dt><dd>@(inventory.Cores > 0 ? inventory.Cores.ToString() : Ui["Not reported"])</dd>
                        <dt>@Ui["Manufacturer / model"]</dt><dd>@Reported(string.Join(" / ", new[] { inventory.Manufacturer, inventory.Model }.Where(value => !string.IsNullOrWhiteSpace(value))))</dd>
                        <dt>@Ui["Uptime"]</dt><dd>@(inventory.ReportedAt is not null ? DisplayFormat.Uptime(inventory.Uptime) : Ui["Not reported"])</dd>
                        <dt>@Ui["Native agent build"]</dt><dd>@Reported(inventory.Version)</dd>
                        <dt>@Ui["Agent platform ID"]</dt><dd>@(inventory.AgentArchitecture > 0 ? inventory.AgentArchitecture.ToString() : Ui["Not reported"])</dd>
                        <dt>@Ui["Last inventory"]</dt><dd>@DisplayFormat.RelativeTime(inventory.ReportedAt)</dd>
                        <dt>@Ui["Last contact"]</dt><dd>@DisplayFormat.RelativeTime(device.LastSeen)</dd>
                        <dt>@Ui["Group"]</dt><dd>@Ui.GroupName(groups.FirstOrDefault(item => item.Id == device.GroupId)?.Name ?? "Unassigned", device.GroupId)</dd>
                        <dt>@Ui["Tags"]</dt><dd>@(string.IsNullOrWhiteSpace(device.Tags) ? Ui["No tags"] : device.Tags)</dd>
                    </dl>
                </section>
                <section class="panel editor-panel">
                    <h2>@Ui["Notes"]</h2>
                    <p class="preserve-lines muted">@(string.IsNullOrWhiteSpace(device.Notes) ? Ui["No notes"] : device.Notes)</p>
                </section>
            </div>

            @if (interfaceRows.TotalCount > 0)
            {
                <PagedTable Result="interfaceRows" Label="Reported network interfaces" ItemKey="InterfaceKey"
                            PageChanged="ChangeInterfacePage" PageSizeChanged="ChangeInterfacePageSize">
                    <Toolbar><h2>@Ui["Reported network interfaces"]</h2></Toolbar>
                    <Header><th>@Ui["Interface"]</th><th>@Ui["Address"]</th><th>@Ui["MAC"]</th><th>@Ui["Family"]</th></Header>
                    <RowTemplate Context="network">
                        <td>@network.Name</td><td>@network.Address</td><td>@Reported(network.Mac)</td><td>@network.Family</td>
                    </RowTemplate>
                </PagedTable>
            }
        }
        else
        {
            <EmptyState Title="Waiting for inventory" Text="The native agent reports hardware and resource information automatically." />
        }

        @if (Can(Permissions.Power) && online)
        {
            <section class="panel editor-panel">
                <h2>@Ui["Power management"]</h2>
                <div class="inline-actions">
                    <button class="button" disabled="@Busy" @onclick='() => Power("restart")'>@Ui["Restart device"]</button>
                    <button class="button danger" disabled="@Busy" @onclick='() => Power("shutdown")'>@Ui["Shut down device"]</button>
                </div>
            </section>
        }
        @if (Can(Permissions.BlockDevices))
        {
            <section class="panel editor-panel">
                <h2>@Ui["Device access in EndpointControl"]</h2>
                <button class="button @(device.Disabled ? "primary" : "danger")" disabled="@Busy" @onclick="Revoke">
                    @Ui[device.Disabled ? "Restore EndpointControl access" : "Block EndpointControl access"]
                </button>
            </section>
        }
        @if (Can(Permissions.RemoveDevices))
        {
            <section class="panel editor-panel">
                <h2>@Ui["Remove device"]</h2>
                <p class="muted">@Ui["Removes this entry. The device returns when its agent reconnects."]</p>
                <button class="button danger" disabled="@Busy" @onclick="Remove">@Ui["Remove device"]</button>
            </section>
        }
    }
    else if (tab == "Remote tools" && !device.Disabled)
    {
        <NetworkTools DeviceId="@Id" @key="Id" />
    }
    else if (device.Disabled || !online)
    {
        <EmptyState Title="Device offline" Text="The agent must be connected to use this tool." />
    }
    else if (tab == "Terminal")
    {
        <RemoteViewer Id="@Id" Tool="terminal" Inline="true" @key="Id" />
    }
    else if (tab == "Commands")
    {
        <CommandPanel DeviceId="@Id" Platform="@(device.Inventory?.Platform ?? "Unknown")" @key="Id" />
    }
    else if (tab == "Files")
    {
        <FileBrowser DeviceId="@Id" @key="Id" />
    }
    else if (tab == "Desktop")
    {
        <DesktopPanel DeviceId="@Id" @key="Id" />
    }
    else if (tab == "Processes")
    {
        <ProcessPanel DeviceId="@Id" @key="Id" />
    }
}
else if (CurrentUser is not null && Error is null)
{
    <EmptyState Title="Device not found" Text="The device is unavailable or has been removed.">
        <a class="button" href="/devices">@Ui["Back to devices"]</a>
    </EmptyState>
}
