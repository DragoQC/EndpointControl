@page "/devices/{Id}"
@attribute [Authorize]
@inherits PageBase
@inject IJSRuntime JS
<PageTitle>@(device?.Name ?? "Device") · MeshAll</PageTitle>
<Notice Error="@Error" Success="@Success" />
@if (device is not null) {
<div class="page-heading"><div><div class="breadcrumb"><a href="/devices">Devices</a> / @device.Name</div><div class="device-title"><span class="device-symbol large blue"><Icon Name="@(device.Inventory?.Platform == "Windows" ? "windows" : "server")" /></span><div><h1>@device.Name</h1><p class="muted">@(device.Inventory?.Os ?? "Waiting for the first inventory")</p></div><span class="status @(Gateway.Online(Id) ? "online" : "offline")"><span class="status-dot"></span>@(device.Disabled ? "Revoked" : Gateway.Online(Id) ? "Online" : "Offline")</span></div></div>
@if (CanManage && !device.Disabled) { <button class="button" @onclick="EditDevice"><Icon Name="settings" />Edit device</button> }</div>
@if (editing) { <section class="panel editor-panel"><h2>Device settings</h2><form @onsubmit="SaveDevice" @onsubmit:preventDefault><div class="form-grid"><label>Display name<input @bind="name" maxlength="100" required /></label><label>Device group<select @bind="group">@foreach (var g in groups) { <option value="@g.Id">@g.Name</option> }</select></label><label>Tags<input @bind="tags" maxlength="300" placeholder="office, production" /></label><label>Notes<textarea @bind="notes" maxlength="4000" rows="2"></textarea></label></div><div class="form-actions"><button type="button" class="button" @onclick="() => editing = false">Cancel</button><button class="button primary" disabled="@Busy">Save changes</button></div></form></section> }
<div class="tab-bar" role="navigation" aria-label="Device views">@foreach (var t in Tabs) { <button class="@(tab == t ? "active" : "")" @onclick="() => tab = t">@t</button> }</div>
@if (tab == "Overview") {
    @if (device.Inventory is { } inv) {
        <div class="device-overview"><section class="panel editor-panel"><h2>Device information</h2><dl class="details-grid"><dt>Hostname</dt><dd>@inv.Hostname</dd><dt>Operating system</dt><dd>@inv.Os</dd><dt>Architecture</dt><dd>@inv.Architecture</dd><dt>Signed-in user</dt><dd>@inv.Username</dd><dt>IP address</dt><dd>@inv.Ip</dd><dt>MAC address</dt><dd>@inv.Mac</dd><dt>CPU cores</dt><dd>@inv.Cores</dd><dt>Uptime</dt><dd>@TimeSpan.FromSeconds(inv.Uptime).ToString(@"d\d\ hh\h\ mm\m")</dd><dt>Agent version</dt><dd>@inv.Version</dd><dt>Last inventory</dt><dd>@Ago(device.LastSeen)</dd><dt>Group</dt><dd>@groups.FirstOrDefault(g => g.Id == device.GroupId)?.Name</dd><dt>Tags</dt><dd>@(string.IsNullOrWhiteSpace(device.Tags) ? "No tags" : device.Tags)</dd></dl></section>
        <div><section class="panel editor-panel"><h2>Resource use</h2>@if (inv.MemoryTotal > 0) { <div class="resource-row"><span>CPU</span><strong>@inv.Cpu.ToString("0.0")%</strong></div><progress max="100" value="@inv.Cpu"></progress><div class="resource-row"><span>Memory</span><strong>@Bytes(inv.MemoryUsed) / @Bytes(inv.MemoryTotal)</strong></div><progress max="@inv.MemoryTotal" value="@inv.MemoryUsed"></progress> } else { <p class="muted">Live resource telemetry is not reported by this control API snapshot. Use the Commands or Processes tab to inspect the device.</p> }@foreach (var disk in inv.Disks) { <div class="resource-row"><span>@disk.Name</span><strong>@Bytes(disk.Free) free of @Bytes(disk.Total)</strong></div><progress max="@(Math.Max(1, disk.Total))" value="@(disk.Total-disk.Free)"></progress> }</section><section class="panel editor-panel"><h2>Notes</h2><p class="preserve-lines muted">@(string.IsNullOrWhiteSpace(device.Notes) ? "Add notes to keep useful details close to this device." : device.Notes)</p></section></div></div>
    } else { <section class="panel"><EmptyState Title="Waiting for inventory" Text="Keep the agent running. Hardware and system information will appear after its first connection." /></section> }
    @if (CanManage && Gateway.Online(Id)) { <section class="panel editor-panel"><h2>Power management</h2><p class="muted">These actions affect the remote device immediately.</p><div class="inline-actions"><button class="button" disabled="@Busy" @onclick='() => Power("restart")'>Restart device</button><button class="button danger" disabled="@Busy" @onclick='() => Power("shutdown")'>Shut down device</button></div></section> }
    @if (IsAdmin) { <section class="panel editor-panel"><h2>Device access in MeshAll</h2><p class="muted">Block remote tools for this device in the MeshAll workspace. You can restore access here later.</p><button class="button @(device.Disabled ? "primary" : "danger")" disabled="@Busy" @onclick="Revoke">@(device.Disabled ? "Restore MeshAll access" : "Block MeshAll access")</button></section> }
} else if (!CanManage) { <section class="panel"><EmptyState Icon="shield" Title="View-only account" Text="An administrator or operator account is needed for remote access." /></section> }
else if (tab == "Remote tools" && !device.Disabled) { <NetworkTools DeviceId="@Id" @key="Id" /> }
else if (tab == "Terminal" && !device.Disabled) { <section class="panel"><iframe class="remote-frame" src="@($"/remote/{Id}/terminal")" title="Interactive agent terminal"></iframe></section> }
else if (device.Disabled || !Gateway.Online(Id)) { <section class="panel"><EmptyState Title="This device is offline" Text="Start the MeshAll agent on the device to use remote tools." /></section> }
else if (tab == "Commands") {
<section class="panel command-panel"><div class="panel-header"><div><h2>Remote commands</h2><p>@(device.Inventory?.Platform == "Windows" ? "PowerShell" : "System shell") · Runs as @device.Inventory?.Username</p></div><button class="button small" @onclick="() => transcript = string.Empty">Clear output</button></div><pre class="terminal-output" role="log" aria-label="Command output">@(string.IsNullOrEmpty(transcript) ? "Connected. Run a command to get started.\n" : transcript)@if (Busy) { <span class="terminal-pending">Running…</span> }</pre>
<form class="command-form" @onsubmit="RunCommand" @onsubmit:preventDefault><div class="form-grid"><label>Working directory<input @bind="directory" placeholder="Agent home directory" /></label><label>Saved script<select value="" @onchange="UseScript"><option value="">Choose a script…</option>@foreach (var s in scripts.Where(s => s.Platform == "Any" || s.Platform == device.Inventory?.Platform)) { <option value="@s.Id">@s.Name</option> }</select></label></div><label>Command<textarea class="code-input" @bind="command" rows="3" placeholder="@(device.Inventory?.Platform == "Windows" ? "Get-ComputerInfo" : "uname -a")" required maxlength="16000"></textarea></label><div class="form-actions"><small class="muted">Each command starts a new shell. Working directory persists here.</small><button class="button primary" disabled="@Busy"><Icon Name="terminal" />Run command</button></div></form></section>
} else if (tab == "Files") { <FileBrowser DeviceId="@Id" @key="Id" /> }
else if (tab == "Desktop") { <DesktopPanel DeviceId="@Id" Supported="@(device.Inventory?.Capabilities.Contains("desktop") == true)" @key="Id" /> }
else if (tab == "Processes") {
<section class="panel"><div class="panel-header"><div><h2>Running processes</h2><p>Read-only process inventory from the device.</p></div><button class="button" disabled="@Busy" @onclick="LoadProcesses">Refresh processes</button></div>@if (processes is null) { <EmptyState Icon="activity" Title="Take a look under the hood" Text="Refresh to load a snapshot of running processes." /> } else { <div class="table-scroll"><table><thead><tr><th>PID</th><th>Name</th><th>Memory</th></tr></thead><tbody>@foreach (var p in processes.OrderByDescending(p => p.Memory)) { <tr><td>@p.Id</td><td><strong>@p.Name</strong></td><td>@Bytes(p.Memory)</td></tr> }</tbody></table></div> }</section>
}
} else if (Error is null) { <EmptyState Title="Device not found" Text="This device is no longer in your workspace." /> }
@code {
    [Parameter] public string Id { get; set; } = "";
    private DeviceInfo? device; private List<GroupInfo> groups = []; private List<ScriptInfo> scripts = [];
    private readonly string[] Tabs = ["Overview", "Commands", "Terminal", "Files", "Desktop", "Remote tools", "Processes"];
    private string tab = "Overview", command = "", directory = "", transcript = "", name = "", group = "", tags = "", notes = "";
    private bool editing; private ProcessInfo[]? processes;
    protected override Task LoadAsync() { device = Store.FindDevice(Id); groups = Store.Groups(); if (CanManage) scripts = Store.Scripts(); return Task.CompletedTask; }
    protected override async Task OnParametersSetAsync() { if (CurrentUser is not null) await LoadAsync(); }
    private void EditDevice() { name = device!.Name; group = device.GroupId; tags = device.Tags; notes = device.Notes; editing = true; }
    private Task SaveDevice() => Act(async () => { await Gateway.SaveDeviceAsync(Id, name, group, tags, notes); Store.Audit(CurrentUser!.Name, "Device updated", name); editing = false; }, "Device saved.");
    private Task RunCommand() => Act(async () => {
        if (string.IsNullOrWhiteSpace(command)) return;
        var cmd = command; transcript += $"\n› {cmd}\n";
        var output = await Workspace.RunAsync<CommandOutput>(Id, "command", new CommandInput(cmd, directory));
        directory = output.Directory; transcript += output.Output + (output.ExitCode < 0 ? "\n[Exit status not reported]\n" : $"\n[exit {output.ExitCode}]\n");
        if (transcript.Length > 150000) transcript = transcript[^150000..];
        command = "";
    });
    private void UseScript(ChangeEventArgs e) { var script = scripts.FirstOrDefault(s => s.Id == e.Value?.ToString()); if (script is not null) command = script.Code; }
    private Task LoadProcesses() => Act(async () => processes = await Workspace.RunAsync<ProcessInfo[]>(Id, "processes", new { }));
    private async Task Power(string action) { if (await JS.InvokeAsync<bool>("confirm", $"{(action == "restart" ? "Restart" : "Shut down")} {device!.Name} now?")) await Act(async () => await Workspace.RunAsync<string>(Id, "power", new PowerInput(action)), "Power action sent."); }
    private async Task Revoke() { if (await JS.InvokeAsync<bool>("confirm", $"{(device!.Disabled ? "Restore" : "Block")} MeshAll access for {device.Name}?")) await Act(() => { var blocked = !device.Disabled; Store.SetDeviceBlocked(Id, blocked); if (blocked) Gateway.Disconnect(Id); Store.Audit(CurrentUser!.Name, blocked ? "Device access blocked" : "Device access restored", device.Name); }, "MeshAll access updated.", true); }
}
