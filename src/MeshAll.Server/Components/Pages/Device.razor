@page "/devices/{Id}"
@attribute [Authorize(Policy = Permissions.Inventory)]
@inherits PageBase
@inject IJSRuntime JS
<PageTitle>@(device?.Name??"Device") · MeshAll</PageTitle>
<Notice Error="@Error" Success="@Success" />
@if(device is not null){
    <div class="page-heading"><div><div class="breadcrumb"><a href="/devices">Devices</a> / @device.Name</div><div class="device-title"><span class="device-symbol large blue"><Icon Name="@(device.Inventory?.Platform=="Windows"?"windows":"server")" /></span><div><h1>@device.Name</h1><p class="muted">@device.Inventory?.Os</p></div><span class="status @(Gateway.Online(Id)?"online":"offline")"><span class="status-dot"></span>@(device.Disabled?"Revoked":Gateway.Online(Id)?"Online":"Offline")</span></div></div>
        <div class="inline-actions">@if(Gateway.Online(Id)){<button class="button" disabled="@Busy" @onclick="RefreshInventory">Refresh inventory</button>}@if(Can(Permissions.EditDevices)&&!device.Disabled){<button class="button" @onclick="EditDevice"><Icon Name="settings" />Edit device</button>}</div>
    </div>
    @if(editing){<section class="panel editor-panel"><h2>Device settings</h2><form @onsubmit="SaveDevice" @onsubmit:preventDefault><div class="form-grid"><label>Display name<input @bind="name" maxlength="100" required /></label><label>Device group<select @bind="group">@foreach(var g in groups){<option value="@g.Id">@g.Name</option>}</select></label><label>Tags<input @bind="tags" maxlength="300" /></label><label>Notes<textarea @bind="notes" maxlength="4000" rows="2"></textarea></label></div><div class="form-actions"><button type="button" class="button" @onclick="() => editing=false">Cancel</button><button class="button primary" disabled="@Busy">Save changes</button></div></form></section>}
    <div class="tab-bar" role="navigation" aria-label="Device views">@foreach(var item in Tabs.Where(Allowed)){<button class="@(tab==item?"active":"")" @onclick="() => tab=item">@item</button>}</div>
    @if(!Allowed(tab)){<EmptyState Icon="shield" Title="Capability not granted" Text="Your role does not grant this capability." />}
    else if(tab=="Overview"){
        @if(device.Inventory is {} inv){
            @if(!string.IsNullOrWhiteSpace(inv.Diagnostic)){<Notice Error="@inv.Diagnostic" />}
            <div class="device-overview"><section class="panel editor-panel"><h2>Device information</h2><dl class="details-grid">
                <dt>Hostname</dt><dd>@Reported(inv.Hostname)</dd><dt>Operating system</dt><dd>@Reported(inv.Os)</dd>
                <dt>Architecture</dt><dd>@Reported(inv.Architecture)</dd><dt>Signed-in user</dt><dd>@(string.IsNullOrWhiteSpace(inv.Username)?"No active user reported":inv.Username)</dd>
                <dt>Primary IP address</dt><dd>@Reported(inv.Ip)</dd><dt>MAC address</dt><dd>@Reported(inv.Mac)</dd>
                <dt>Connection address</dt><dd>@Reported(inv.ConnectionAddress)</dd><dt>CPU model</dt><dd>@Reported(inv.CpuModel)</dd>
                <dt>Logical CPU cores</dt><dd>@(inv.Cores>0?inv.Cores.ToString():"Not reported")</dd>
                <dt>Manufacturer / model</dt><dd>@Reported(string.Join(" / ",new[]{inv.Manufacturer,inv.Model}.Where(s=>!string.IsNullOrWhiteSpace(s))))</dd>
                <dt>Uptime</dt><dd>@(inv.ReportedAt is not null?TimeSpan.FromSeconds(Math.Max(0,inv.Uptime)).ToString(@"d\d\ hh\h\ mm\m"):"Not reported")</dd>
                <dt>Native agent build</dt><dd>@Reported(inv.Version)</dd><dt>Agent platform ID</dt><dd>@(inv.AgentArchitecture>0?inv.AgentArchitecture.ToString():"Not reported")</dd>
                <dt>Last inventory</dt><dd>@(inv.ReportedAt is {} reported?Ago(reported):"Waiting for a complete inventory report")</dd><dt>Last contact</dt><dd>@Ago(device.LastSeen)</dd>
                <dt>Group</dt><dd>@groups.FirstOrDefault(g=>g.Id==device.GroupId)?.Name</dd><dt>Tags</dt><dd>@(string.IsNullOrWhiteSpace(device.Tags)?"No tags":device.Tags)</dd>
            </dl></section>
            <div><section class="panel editor-panel"><h2>Resource use</h2>
                @if(inv.ReportedAt is not null&&inv.MemoryTotal>0){
                    <div class="resource-row"><span>CPU</span><strong>@(inv.Cpu>=0?inv.Cpu.ToString("0.0")+"%":"Sampling…")</strong></div>@if(inv.Cpu>=0){<progress max="100" value="@inv.Cpu"></progress>}
                    <div class="resource-row"><span>Memory</span><strong>@Bytes(inv.MemoryUsed) / @Bytes(inv.MemoryTotal)</strong></div><progress max="@inv.MemoryTotal" value="@inv.MemoryUsed"></progress>
                }else{<p class="muted">Waiting for the agent's hardware and resource report.</p>}
                @foreach(var disk in inv.Disks){<div class="resource-row"><span>@disk.Name</span><strong>@Bytes(disk.Free) free of @Bytes(disk.Total)</strong></div><progress max="@Math.Max(1,disk.Total)" value="@(disk.Total-disk.Free)"></progress>}
            </section><section class="panel editor-panel"><h2>Notes</h2><p class="preserve-lines muted">@(string.IsNullOrWhiteSpace(device.Notes)?"Add notes to keep useful details close to this device.":device.Notes)</p></section></div></div>
            @if(inv.Interfaces is {Length:>0}){<section class="panel"><div class="panel-header"><h2>Reported network interfaces</h2></div><div class="table-scroll"><table><thead><tr><th>Interface</th><th>Address</th><th>MAC</th><th>Family</th></tr></thead><tbody>@foreach(var nic in inv.Interfaces){<tr><td>@nic.Name</td><td>@nic.Address</td><td>@Reported(nic.Mac)</td><td>@nic.Family</td></tr>}</tbody></table></div></section>}
        }else{<EmptyState Title="Waiting for inventory" Text="The native agent reports hardware and resource information automatically." />}
        @if(Can(Permissions.Power)&&Gateway.Online(Id)){<section class="panel editor-panel"><h2>Power management</h2><div class="inline-actions"><button class="button" disabled="@Busy" @onclick='() => Power("restart")'>Restart device</button><button class="button danger" disabled="@Busy" @onclick='() => Power("shutdown")'>Shut down device</button></div></section>}
        @if(Can(Permissions.BlockDevices)){<section class="panel editor-panel"><h2>Device access in MeshAll</h2><button class="button @(device.Disabled?"primary":"danger")" disabled="@Busy" @onclick="Revoke">@(device.Disabled?"Restore MeshAll access":"Block MeshAll access")</button></section>}
    }else if(tab=="Remote tools"&&!device.Disabled){<NetworkTools DeviceId="@Id" @key="Id" />}
    else if(device.Disabled||!Gateway.Online(Id)){<EmptyState Title="This device is offline" Text="Start the MeshAll agent on the device to use remote tools." />}
    else if(tab=="Terminal"){<section class="panel"><iframe class="remote-frame" src="@($"/remote/{Id}/terminal")" title="Interactive agent terminal"></iframe></section>}
    else if(tab=="Commands"){
        <section class="panel command-panel"><div class="panel-header"><div><h2>Remote commands</h2><p>@(device.Inventory?.Platform=="Windows"?"PowerShell":"System shell") · Executes as the agent service account</p></div><button class="button small" @onclick="() => transcript=string.Empty">Clear output</button></div>
            <pre class="terminal-output" role="log" aria-label="Command output">@(string.IsNullOrEmpty(transcript)?"Connected. Run a command to get started.\n":transcript)@if(Busy){<span class="terminal-pending">Running…</span>}</pre>
            <form class="command-form" @onsubmit="RunCommand" @onsubmit:preventDefault><div class="form-grid"><label>Working directory<input @bind="directory" placeholder="Agent home directory" /></label><label>Saved script<select value="" @onchange="UseScript"><option value="">Choose a script…</option>@foreach(var script in scripts.Where(s=>s.Platform=="Any"||s.Platform==device.Inventory?.Platform)){<option value="@script.Id">@script.Name</option>}</select></label></div><label>Command<textarea class="code-input" @bind="command" rows="3" required maxlength="16000"></textarea></label><div class="form-actions"><small class="muted">Each command starts a new shell. Working directory persists here.</small><button class="button primary" disabled="@Busy">Run command</button></div></form>
        </section>
    }else if(tab=="Files"){<FileBrowser DeviceId="@Id" @key="Id" />}
    else if(tab=="Desktop"){<DesktopPanel DeviceId="@Id" Supported="true" @key="Id" />}
    else if(tab=="Processes"){<section class="panel"><div class="panel-header"><h2>Running processes</h2><button class="button" disabled="@Busy" @onclick="LoadProcesses">Refresh processes</button></div>@if(processes is null){<EmptyState Icon="activity" Title="Take a look under the hood" Text="Refresh to load a snapshot of running processes." />}else{<div class="table-scroll"><table><thead><tr><th>PID</th><th>Name</th><th>Memory</th></tr></thead><tbody>@foreach(var process in processes.OrderByDescending(p=>p.Memory)){<tr><td>@process.Id</td><td>@process.Name</td><td>@Bytes(process.Memory)</td></tr>}</tbody></table></div>}</section>}
}
@code{
    [Parameter]public string Id{get;set;}="";
    private DeviceInfo? device;private List<GroupInfo> groups=[];private List<ScriptInfo> scripts=[];
    private readonly string[] Tabs=["Overview","Commands","Terminal","Files","Desktop","Remote tools","Processes"];
    private string tab="Overview",command="",directory="",transcript="",name="",group="",tags="",notes="";private bool editing;private ProcessInfo[]? processes;
    private bool Allowed(string item)=>item switch{"Overview"=>Can(Permissions.Inventory),"Commands"=>Can(Permissions.Commands),"Terminal"=>Can(Permissions.Terminal),"Files"=>Can(Permissions.FilesRead),"Desktop"=>Can(Permissions.Desktop),"Processes"=>Can(Permissions.Processes),"Remote tools"=>new[]{Permissions.Rdp,Permissions.Vnc,Permissions.Ssh,Permissions.Amt,Permissions.Terminal}.Any(Can),_=>false};
    private static string Reported(string? value)=>string.IsNullOrWhiteSpace(value)?"Not reported":value;
    protected override Task LoadAsync(){device=Store.FindDevice(Id);groups=Store.Groups();scripts=Can(Permissions.Scripts)?Store.Scripts():[];return Task.CompletedTask;}
    protected override async Task OnParametersSetAsync(){if(CurrentUser is not null)await LoadAsync();}
    private void EditDevice(){name=device!.Name;group=device.GroupId;tags=device.Tags;notes=device.Notes;editing=true;}
    private Task SaveDevice()=>Act(async()=>{await Gateway.SaveDeviceAsync(Id,name,group,tags,notes);Store.Audit(CurrentUser!.Name,"Device updated",name);editing=false;},"Device saved.",Permissions.EditDevices);
    private Task RefreshInventory()=>Act(async()=>await Workspace.RunAsync<string>(Id,"inventory.refresh",new{}),"Inventory refresh requested. Reports update automatically.",Permissions.Inventory);
    private Task RunCommand()=>Act(async()=>{if(string.IsNullOrWhiteSpace(command))return;var input=command;transcript+=$"\n› {input}\n";var result=await Workspace.RunAsync<CommandOutput>(Id,"command",new CommandInput(input,directory));directory=result.Directory;transcript+=result.Output+(result.ExitCode<0?"\n[Exit status not reported]\n":$"\n[exit {result.ExitCode}]\n");if(transcript.Length>150000)transcript=transcript[^150000..];command="";},permission:Permissions.Commands);
    private void UseScript(ChangeEventArgs e){var script=scripts.FirstOrDefault(s=>s.Id==e.Value?.ToString());if(script is not null)command=script.Code;}
    private Task LoadProcesses()=>Act(async()=>processes=await Workspace.RunAsync<ProcessInfo[]>(Id,"processes",new{}),permission:Permissions.Processes);
    private async Task Power(string action){if(await JS.InvokeAsync<bool>("confirm",$"{(action=="restart"?"Restart":"Shut down")} {device!.Name} now?"))await Act(async()=>await Workspace.RunAsync<string>(Id,"power",new PowerInput(action)),"Power action sent.",Permissions.Power);}
    private async Task Revoke(){if(await JS.InvokeAsync<bool>("confirm",$"{(device!.Disabled?"Restore":"Block")} MeshAll access for {device.Name}?"))await Act(()=>{var blocked=!device.Disabled;Store.SetDeviceBlocked(Id,blocked);if(blocked)Gateway.Disconnect(Id);Store.Audit(CurrentUser!.Name,blocked?"Device access blocked":"Device access restored",device.Name);},"MeshAll access updated.",Permissions.BlockDevices);}
}
