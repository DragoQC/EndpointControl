@page "/devices"
@attribute [Authorize(Policy = Permissions.Inventory)]
@inherits PagedPageBase<DeviceInfo>

<PageTitle>@Ui["Devices"] · @ProductBrand.Name</PageTitle>
<PageHeader Title="Devices">
    <Actions>
        <a class="button" href="/">@Ui["Dashboard"]</a>
        @if (Can(Permissions.Enroll))
        {
            <a class="button primary" href="/enroll"><Icon Name="plus" />@Ui["Add device"]</a>
        }
    </Actions>
</PageHeader>
<Notice Error="@Error" />

<section class="panel">
    <div class="filter-bar">
        <SearchField Value="@Search" ValueChanged="ChangeSearchAsync" Label="Search devices"
                     Placeholder="Search devices, IPs, or tags…" />
        <SelectField TValue="string" Value="@status" Changed="StatusChangedAsync" aria-label="@Ui["Connection status"]">
            <option value="all">@Ui["All statuses"]</option><option value="online">@Ui["Online"]</option>
            <option value="offline">@Ui["Offline"]</option><option value="revoked">@Ui["Blocked"]</option>
        </SelectField>
        <SelectField TValue="string" Value="@group" Changed="GroupChangedAsync" aria-label="@Ui["Device group"]">
            <option value="">@Ui["All groups"]</option>
            @foreach (GroupInfo item in groups)
            {
                <option value="@item.Id">@Ui.GroupName(item.Name, item.Id)</option>
            }
        </SelectField>
        <span class="result-count">@Ui.Plural(Rows.TotalCount, "{0} result", "{0} results")</span>
    </div>
    <DeviceTable Items="Rows.Items" Groups="groups" ConnectedIds="connectedIds" />
    <Pagination TotalCount="Rows.TotalCount" PageNumber="Rows.PageNumber" PageSize="Rows.PageSize"
                PageChanged="ChangePageAsync" PageSizeChanged="ChangePageSizeAsync" Label="Device pages" />
</section>

@code
{
    [SupplyParameterFromQuery(Name = "group")]
    public string? InitialGroup { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? InitialStatus { get; set; }

    private string status = "all";
    private string group = "";
    private List<GroupInfo> groups = [];
    private HashSet<string> connectedIds = new(StringComparer.Ordinal);
    protected override async Task OnParametersSetAsync()
    {
        group = InitialGroup ?? "";
        status = InitialStatus ?? "all";
        if (CurrentUser is not null)
        {
            await ResetPageAsync();
        }
    }

    protected override PageResult<DeviceInfo> ReadPage(PageRequest request)
    {
        groups = Store.Groups();
        connectedIds = Gateway.ConnectedDeviceIds();
        return Store.DevicePage(request, connectedIds, Search, status, group);
    }

    private Task StatusChangedAsync(ChangeEventArgs arguments)
    {
        status = arguments.Value?.ToString() ?? "all";
        return ResetPageAsync();
    }

    private Task GroupChangedAsync(ChangeEventArgs arguments)
    {
        group = arguments.Value?.ToString() ?? "";
        return ResetPageAsync();
    }
}
