@page "/devices"
@attribute [Authorize]
@inherits PageBase
<PageTitle>Devices · MeshAll</PageTitle>
<div class="page-heading"><div><div class="breadcrumb">Workspace / Devices</div><h1>Your devices</h1><p class="muted">A clear view of everything you manage.</p></div>@if (IsAdmin) { <a class="button primary" href="/enroll"><Icon Name="plus" />Add device</a> }</div>
<Notice Error="@Error" />
<section class="panel"><div class="filter-bar"><div class="search-field"><Icon Name="search" /><input @bind="search" @bind:event="oninput" placeholder="Search devices, IPs, or tags…" aria-label="Search devices" /></div>
<select @bind="status" aria-label="Connection status"><option value="all">All statuses</option><option value="online">Online</option><option value="offline">Offline</option><option value="revoked">Revoked</option></select>
<select @bind="group" aria-label="Device group"><option value="">All groups</option>@foreach (var g in groups) { <option value="@g.Id">@g.Name</option> }</select><span class="result-count">@Filtered.Count() results</span></div>
@if (!Filtered.Any()) { <EmptyState Title="No devices to show" Text="Try a different filter, or enroll a new device to get started." /> }
else { <FleetTable Items="Filtered" Groups="groups" /> }
<div class="panel-foot"><span>Inventory refreshes automatically</span><span>@devices.Count total devices</span></div></section>
@code {
    [SupplyParameterFromQuery(Name = "group")] public string? InitialGroup { get; set; }
    private string search = "", status = "all", group = "";
    private List<DeviceInfo> devices = []; private List<GroupInfo> groups = [];
    private IEnumerable<DeviceInfo> Filtered => devices.Where(d =>
        (string.IsNullOrEmpty(group) || d.GroupId == group) &&
        (status == "all" || status == "revoked" && d.Disabled || status == "online" && Gateway.Online(d.Id) || status == "offline" && !Gateway.Online(d.Id) && !d.Disabled) &&
        $"{d.Name} {d.Tags} {d.Inventory?.Ip} {d.Inventory?.Os}".Contains(search, StringComparison.OrdinalIgnoreCase));
    protected override void OnParametersSet() { if (InitialGroup is not null) group = InitialGroup; }
    protected override Task LoadAsync() { devices = Store.Devices(); groups = Store.Groups(); return Task.CompletedTask; }
}
