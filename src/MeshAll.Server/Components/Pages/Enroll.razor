@page "/enroll"
@attribute [Authorize(Policy = Permissions.Enroll)]
@inherits PagedPageBase<TokenInfo>
@inject EnrollmentDownloads Downloads

<PageTitle>@Ui["Enrollment keys"] · @ProductBrand.Name</PageTitle>
<PageHeader Title="Enrollment keys" Description="Create a key, then select it to download its installers." />
<Notice Error="@Error" Success="@Success" />

<section class="panel editor-panel enrollment-create">
    <h2>@Ui["Create an enrollment key"]</h2>
    <form @onsubmit="Generate" @onsubmit:preventDefault>
        <div class="form-grid">
            <label>@Ui["Key name"]<input @bind="name" required maxlength="70" /></label>
            <label>@Ui["Device group"]
                <SelectField TValue="string" Expand="true" @bind-Value="group">
                    @foreach (GroupInfo item in groups)
                    {
                        <option value="@item.Id">@Ui.GroupName(item.Name, item.Id)</option>
                    }
                </SelectField>
            </label>
            <label>@Ui["Amount of uses"]<input type="number" @bind="uses" min="1" max="@EnrollmentPolicy.MaximumDevices" /></label>
            <label>@Ui["Expires in (hours)"]<input type="number" @bind="hours" min="1" max="@EnrollmentPolicy.MaximumHours" /></label>
        </div>
        <p class="muted small-text">@Ui["Every installer shares this key's amount of uses. Only a new device registration consumes a use."]</p>
        <button class="button primary" disabled="@Busy">@Ui["Create enrollment key"]</button>
    </form>
</section>

<PagedTable Result="Rows" Label="Enrollment keys" ItemKey="key => key.Id"
            PageChanged="ChangePageAsync" PageSizeChanged="ChangePageSizeAsync"
            EmptyTitle="No enrollment keys" EmptyText="Create a key to connect a device.">
    <Toolbar><h2>@Ui["Enrollment keys"]</h2><span class="muted small-text">@Ui["Select a key to view its details and downloads."]</span></Toolbar>
    <Header><th>@Ui["Name"]</th><th>@Ui["Device group"]</th><th>@Ui["Expires"]</th><th>@Ui["Uses remaining"]</th><th></th></Header>
    <RowTemplate Context="key">
        <td><button type="button" class="link-button enrollment-key-link" aria-disabled="@(Busy ? "true" : "false")" data-enrollment-id="@key.Id" @onclick="() => OpenKey(key.Id)">@key.Name</button></td>
        <td>@GroupName(key)</td>
        <td>@key.Expires.ToLocalTime().ToString("g")</td>
        <td>@key.Remaining</td>
        <td><button class="link-button danger-text" disabled="@Busy" @onclick="() => Revoke(key)">@Ui["Revoke"]</button></td>
    </RowTemplate>
</PagedTable>

@if (selected is not null && CurrentUser is not null && Can(Permissions.Enroll))
{
    <EnrollmentKeyDialog Details="selected" GroupName="@GroupName(selected.Information)" Closed="CloseKey" />
}
