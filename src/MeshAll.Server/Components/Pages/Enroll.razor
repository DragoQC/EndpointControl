@page "/enroll"
@attribute [Authorize(Policy = Permissions.Enroll)]
@inherits PageBase
@inject NativeAgentHub NativeAgents
<PageTitle>Add a device · MeshAll</PageTitle>
<div class="page-heading"><div><div class="breadcrumb"><a href="/devices">Devices</a> / Add a device</div><h1>Download. Install. Connected.</h1><p class="muted">One executable with your MeshAll instance and enrollment policy already embedded.</p></div></div>
<Notice Error="@Error" Success="@Success" />
<div class="enroll-grid"><section class="panel editor-panel"><h2>Create an enrollment key</h2><form @onsubmit="Generate" @onsubmit:preventDefault>
    <label>Key name<input @bind="name" required maxlength="70" /></label><label>Device group<select @bind="group">@foreach(var item in groups){<option value="@item.Id">@item.Name</option>}</select></label>
    <div class="form-grid"><label>Maximum devices<input type="number" @bind="uses" min="1" max="100" /></label><label>Expires in (hours)<input type="number" @bind="hours" min="1" max="168" /></label></div>
    <button class="button primary" disabled="@Busy">Create enrollment key</button>
</form></section>
<section class="panel editor-panel"><span class="stat-icon blue"><Icon Name="windows" /></span><h2 class="mt-4">The native installation experience.</h2>
    <p class="muted">Windows: download and run the executable, then use the native Install / Update action. The service starts and connects to this instance automatically.</p>
    @if(token is not null){
        <div class="download-links">@foreach(var platform in NativeAgents.AvailablePlatforms){<a class="button" href="@($"/api/agents/native-executable?token={token}&platform={platform}")"><Icon Name="download" />@Label(platform)</a>}</div>
        <p class="muted small-text mt-4">The same single-file format includes the instance configuration for Linux and macOS. After download: <code>chmod +x MeshAllAgent; sudo ./MeshAllAgent -fullinstall</code>.</p>
        <p class="muted small-text mt-3">Install the background service with the enrollment key before using an interactive agent identity. Enrollment expiry does not disconnect an already enrolled device.</p>
    }else{<div class="code-placeholder">Create a key to download an enrollment-ready executable.</div>}
    <p class="muted small-text mt-4">Native component notices are embedded in the executable and available under <a class="text-link" href="/licenses/agent" target="_blank" rel="noopener">agent licenses</a>.</p>
</section></div>
<section class="panel"><div class="panel-header"><h2>Enrollment keys</h2></div><div class="table-scroll"><table><thead><tr><th>Name</th><th>Expires</th><th>Uses remaining</th><th></th></tr></thead><tbody>@foreach(var item in tokens){<tr><td>@item.Name</td><td>@item.Expires.ToLocalTime().ToString("g")</td><td>@item.Remaining</td><td><button class="link-button danger-text" @onclick="() => Revoke(item)">Revoke</button></td></tr>}</tbody></table></div></section>
@code{
    protected override string? ViewPermission=>Permissions.Enroll;
    protected override string? ChangePermission=>Permissions.Enroll;
    private List<GroupInfo> groups=[];private List<TokenInfo> tokens=[];private string name="",group="default";private int uses=1,hours=24;private string? token;
    private static string Label(string platform)=>platform switch{"win-x64"=>"Windows x64 (.exe)","win-arm64"=>"Windows ARM64 (.exe)","linux-x64"=>"Linux x64","linux-arm64"=>"Linux ARM64","osx-x64"=>"macOS Intel","osx-arm64"=>"macOS Apple Silicon",_=>platform};
    protected override Task LoadAsync(){groups=Store.Groups();tokens=Store.Tokens();return Task.CompletedTask;}
    private Task Generate()=>Act(()=>{token=Store.CreateToken(name,group,uses,hours).Token;Store.Audit(CurrentUser!.Name,"Enrollment key created",name);},"Enrollment key created.");
    private Task Revoke(TokenInfo item)=>Act(()=>{Store.RevokeToken(item.Id);Store.Audit(CurrentUser!.Name,"Enrollment key revoked",item.Name);},"Enrollment key revoked.");
}
