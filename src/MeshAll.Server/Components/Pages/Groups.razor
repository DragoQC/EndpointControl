@page "/groups"
@attribute [Authorize(Policy = Permissions.Inventory)]
@inherits PagedPageBase<GroupInfo>
@inject IJSRuntime JS

<PageTitle>@Ui["Device groups"] · @ProductBrand.Name</PageTitle>
<PageHeader Title="Device groups">
    <Actions>
        @if (Can(Permissions.Groups))
        {
            <button class="button primary" @onclick="NewGroup"><Icon Name="plus" />@Ui["New group"]</button>
        }
    </Actions>
</PageHeader>
<Notice Error="@Error" Success="@Success" />

@if (editing)
{
    <section class="panel editor-panel">
        <h2>@Ui[editId is null ? "New device group" : "Edit device group"]</h2>
        <form @onsubmit="Save" @onsubmit:preventDefault>
            <div class="form-grid">
                <label>@Ui["Group name"]<input @bind="name" required maxlength="70" /></label>
                <label>@Ui["Description"]<input @bind="description" maxlength="500" /></label>
            </div>
            <fieldset class="privacy-settings">
                <legend>@Ui["User privacy"]</legend>
                <label class="checkbox-label"><input type="checkbox" @bind="askBeforeScreen" />@Ui["Ask the user before showing their screen"]</label>
                <p class="muted small-text">@Ui["Each screen session requires approval. Requests expire after 30 seconds."]</p>
                <label class="checkbox-label"><input type="checkbox" @bind="notifyUser" />@Ui["Notify the user when desktop access starts"]</label>
                <label class="checkbox-label"><input type="checkbox" @bind="showToolbar" />@Ui["Show a connection toolbar on the user’s desktop"]</label>
                <p class="muted small-text">@Ui["This policy also applies to RDP, VNC and AMT access through the agent."]</p>
            </fieldset>
            <div class="form-actions">
                <button class="button" type="button" @onclick="() => editing = false">@Ui["Cancel"]</button>
                <button class="button primary" disabled="@Busy">@Ui["Save group"]</button>
            </div>
        </form>
    </section>
}

<div class="group-grid">
    @foreach (GroupInfo group in Rows.Items)
    {
        <section class="panel group-card" @key="group.Id">
            <div class="group-card-top">
                <span class="group-icon"><Icon Name="layers" /></span>
                <span class="count-badge">@Ui.Plural(deviceCounts.GetValueOrDefault(group.Id), "{0} device", "{0} devices")</span>
            </div>
            <h2><a href="@($"/devices?group={group.Id}")">@Ui.GroupName(group.Name, group.Id)</a></h2>
            @if (!string.IsNullOrWhiteSpace(group.Description) && !(group.Id == "default" && group.Description == "Devices awaiting a home"))
            {
                <p class="muted">@group.Description</p>
            }
            <div class="group-card-foot">
                <a class="text-link" href="@($"/devices?group={group.Id}")">@Ui["View devices"] <Icon Name="arrow" /></a>
                @if (Can(Permissions.Groups))
                {
                    <div class="inline-actions">
                        <button class="link-button" @onclick="() => Edit(group)">@Ui["Edit"]</button>
                        @if (group.Id != "default")
                        {
                            <button class="link-button danger-text" @onclick="() => Delete(group)">@Ui["Delete"]</button>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>
<Pagination TotalCount="Rows.TotalCount" PageNumber="Rows.PageNumber" PageSize="Rows.PageSize"
            PageChanged="ChangePageAsync" PageSizeChanged="ChangePageSizeAsync" Label="Device group pages" />

@code
{
    protected override string? ChangePermission => Permissions.Groups;

    private Dictionary<string, long> deviceCounts = [];
    private bool editing;
    private bool askBeforeScreen;
    private bool notifyUser;
    private bool showToolbar;
    private int originalConsent;
    private string? editId;
    private string name = "";
    private string description = "";
    protected override PageResult<GroupInfo> ReadPage(PageRequest request)
    {
        deviceCounts = Store.DeviceCountsByGroup();
        return Store.GroupPage(request);
    }

    private void NewGroup()
    {
        editId = null;
        name = description = "";
        originalConsent = 0;
        askBeforeScreen = notifyUser = showToolbar = false;
        editing = true;
    }

    private void Edit(GroupInfo group)
    {
        editId = group.Id;
        name = group.Name;
        description = group.Description;
        originalConsent = group.Consent;
        askBeforeScreen = (group.Consent & 8) != 0;
        notifyUser = (group.Consent & 1) != 0;
        showToolbar = (group.Consent & 64) != 0;
        editing = true;
    }

    private Task Save() => Act(async () =>
    {
        int consent = (originalConsent & ~73) | (askBeforeScreen ? 8 : 0) | (notifyUser ? 1 : 0) | (showToolbar ? 64 : 0);
        await Gateway.SaveGroupAsync(editId, name, description, consent);
        Store.Audit(CurrentUser!.Name, "Group saved", name, askBeforeScreen ? "Desktop requires user consent" : "Desktop consent not required");
        editing = false;
    }, "Group saved.");
    private async Task Delete(GroupInfo group)
    {
        if (await JS.InvokeAsync<bool>("confirm", Ui["Delete {0}? Devices will move to Unassigned.", Ui.GroupName(group.Name, group.Id)]))
        {
            await Act(async () =>
            {
                await Gateway.DeleteGroupAsync(group.Id);
                Store.Audit(CurrentUser!.Name, "Group deleted", group.Name);
            }, "Group deleted.");
        }
    }
}
