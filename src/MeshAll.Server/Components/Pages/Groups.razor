@page "/groups"
@attribute [Authorize]
@inherits PageBase
@inject IJSRuntime JS
<PageTitle>Device groups · MeshAll</PageTitle>
<div class="page-heading"><div><div class="breadcrumb">Workspace / Device groups</div><h1>A place for everything.</h1><p class="muted">Organize devices by team, location, or purpose.</p></div>@if (IsAdmin) { <button class="button primary" @onclick="NewGroup"><Icon Name="plus" />New group</button> }</div>
<Notice Error="@Error" Success="@Success" />
@if (editing) { <section class="panel editor-panel"><h2>@(editId is null ? "New device group" : "Edit device group")</h2><form @onsubmit="Save" @onsubmit:preventDefault><div class="form-grid"><label>Group name<input @bind="name" required maxlength="70" /></label><label>Description<input @bind="description" maxlength="500" /></label></div>
<fieldset class="rounded-lg border border-[var(--border)] bg-[var(--hover)] p-5 mb-5"><legend class="px-2 font-semibold text-sm">User privacy</legend><label class="checkbox-label"><input type="checkbox" @bind="askBeforeScreen" />Ask the user before showing their screen</label><p class="muted small-text mt-2 mb-4">The agent prompts the person at the PC. Desktop frames stay blocked until they approve. The owned MeshAll engine denies on timeout and does not remember approval for later sessions.</p><label class="checkbox-label mb-3"><input type="checkbox" @bind="notifyUser" />Notify the user when desktop access starts</label><label class="checkbox-label"><input type="checkbox" @bind="showToolbar" />Show a connection toolbar on the user’s desktop</label><p class="muted small-text mt-3">RDP, VNC, and AMT sessions also request approval through the owned MeshAll agent core before their relay opens. Without an updated online core, those consent-required sessions fail closed.</p></fieldset>
<div class="form-actions"><button class="button" type="button" @onclick="() => editing = false">Cancel</button><button class="button primary" disabled="@Busy">Save group</button></div></form></section> }
<div class="group-grid">@foreach (var g in groups) { <section class="panel group-card"><div class="group-card-top"><span class="group-icon"><Icon Name="layers" /></span><span class="count-badge">@devices.Count(d => d.GroupId == g.Id) devices</span></div><h2><a href="@($"/devices?group={g.Id}")">@g.Name</a></h2><p class="muted">@(string.IsNullOrEmpty(g.Description) ? "No description yet." : g.Description)</p><div class="group-card-foot"><a class="text-link" href="@($"/devices?group={g.Id}")">View devices <Icon Name="arrow" /></a>@if (IsAdmin) { <div class="inline-actions"><button class="link-button" @onclick="() => Edit(g)">Edit</button>@if (g.Id != "default") { <button class="link-button danger-text" @onclick="() => Delete(g)">Delete</button> }</div> }</div></section> }</div>
@code {
    private List<GroupInfo> groups = []; private List<DeviceInfo> devices = [];
    private bool editing, askBeforeScreen = true, notifyUser = true, showToolbar = true; private int originalConsent; private string? editId; private string name = "", description = "";
    protected override Task LoadAsync() { groups = Store.Groups(); devices = Store.Devices(); return Task.CompletedTask; }
    private void NewGroup() { editId = null; name = description = ""; originalConsent = 0; askBeforeScreen = notifyUser = showToolbar = true; editing = true; }
    private void Edit(GroupInfo g) { editId = g.Id; name = g.Name; description = g.Description; originalConsent = g.Consent; askBeforeScreen = (g.Consent & 8) != 0; notifyUser = (g.Consent & 1) != 0; showToolbar = (g.Consent & 64) != 0; editing = true; }
    private Task Save() => Act(async () => { var consent = (originalConsent & ~73) | (askBeforeScreen ? 8 : 0) | (notifyUser ? 1 : 0) | (showToolbar ? 64 : 0); await Gateway.SaveGroupAsync(editId, name, description, consent); Store.Audit(CurrentUser!.Name, "Group saved", name, askBeforeScreen ? "Desktop requires user consent" : "Desktop consent not required"); editing = false; }, "Group saved.", admin: true);
    private async Task Delete(GroupInfo g) { if (await JS.InvokeAsync<bool>("confirm", $"Delete {g.Name}? Devices will move to Unassigned.")) await Act(async () => { await Gateway.DeleteGroupAsync(g.Id); Store.Audit(CurrentUser!.Name, "Group deleted", g.Name); }, "Group deleted.", admin: true); }
}
