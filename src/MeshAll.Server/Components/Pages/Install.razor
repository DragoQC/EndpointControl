@page "/install"
@attribute [Authorize(Policy = Permissions.Settings)]
@inherits PageBase
@inject IJSRuntime JS

<PageTitle>@Ui["Debian installation"] · @ProductBrand.Name</PageTitle>
<PageHeader Title="Server installation" Description="Run this command as root on Debian 13." />
<Notice Error="@Error" Success="@Success" />

<div class="enroll-grid">
    <section class="panel editor-panel">
        <h2>@Ui["Install EndpointControl"]</h2>
        <textarea class="code-input" readonly rows="4" value="@Command"></textarea>
        <button class="button primary" @onclick="Copy">@Ui["Copy command"]</button>
    </section>
    <section class="panel editor-panel">
        <h2>@Ui["Server layout"]</h2>
        <dl class="details-grid">
            <dt>@Ui["Web UI / agent endpoint"]</dt><dd>@Ui["HTTPS 5188"]</dd>
            <dt>@Ui["Source"]</dt><dd><code>/opt/meshall/source</code></dd>
            <dt>@Ui["Configuration"]</dt><dd><code>/etc/meshall</code></dd>
            <dt>@Ui["SQLite/state"]</dt><dd><code>/var/lib/meshall/server</code></dd>
            <dt>@Ui["Update own edits"]</dt><dd><code>meshall-update --local</code></dd>
            <dt>@Ui["Update GitHub"]</dt><dd><code>meshall-update --pull</code></dd>
        </dl>
    </section>
</div>

@code
{
    protected override string? ViewPermission => Permissions.Settings;

    private const string Command = "curl -fsSL https://raw.githubusercontent.com/DragoQC/EndpointControl/main/install.sh | bash";
    private async Task Copy()
    {
        try
        {
            await Workspace.RequireAsync(Permissions.Settings);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Command);
            Success = "Installation command copied.";
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
    }
}
