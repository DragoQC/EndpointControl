@page "/remote/{Id}/{Tool}"
@layout ToolLayout
@attribute [Authorize]

<PageTitle>@Ui[RemoteTools.Label(Tool)] · @ProductBrand.Name</PageTitle>
<RemoteViewer Id="@Id" Tool="@Tool" AutoConnect="@AutoConnect" RequestedPort="@RequestedPort"
              RequestedDirect="@RequestedDirect" @key="(Id, Tool)" />

@code
{
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Tool { get; set; } = "desktop";
    [SupplyParameterFromQuery(Name = "connect")] public bool AutoConnect { get; set; }
    [SupplyParameterFromQuery(Name = "port")] public int? RequestedPort { get; set; }
    [SupplyParameterFromQuery(Name = "direct")] public bool? RequestedDirect { get; set; }
}
