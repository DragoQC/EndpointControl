@page "/account/security"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject Store Store
@using System.Security.Claims
@using QRCoder
<PageTitle>Account security · MeshAll</PageTitle>
<div class="page-heading"><div><div class="breadcrumb">Your profile / Security</div><h1>Protect your account.</h1><p class="muted">Authenticator-based two-factor authentication for @user?.Name.</p></div></div>
@if (user is not null) {
    @if (HttpContext.User.HasClaim("setup_required","true")) { <Notice Success="This instance requires two-factor authentication. Complete setup to access your workspace." /> }
    @if (Failed is not null) { <Notice Error="This security change could not be completed. Check your password and use a fresh authenticator code. Setup expires after ten minutes; codes can only be used once." /> }
    @if (codes is not null) {
        <section class="panel editor-panel"><h2>Save your recovery codes</h2><p class="muted">Each code can be used once if you lose access to your authenticator. These codes are shown only once.</p>
            <ul class="recovery-codes" aria-label="Recovery codes">@foreach(var recoveryCode in codes) { <li><code>@recoveryCode</code></li> }</ul>
            <a class="button primary mt-4" href="/account/security">I saved my recovery codes</a>
        </section>
    }
    <div class="settings-grid"><section class="panel editor-panel">
        <h2>Two-factor authentication: @(user.TwoFactorEnabled?"Enabled":"Not enabled")</h2>
        @if (!user.TwoFactorEnabled && secret is null) {
            <p class="muted">Use an authenticator app such as Microsoft Authenticator, Google Authenticator, or Aegis.</p>
            <form action="/auth/2fa/setup" method="post" data-enhance="false"><AntiforgeryToken />
                <label>Current password<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>
                <button class="button primary" type="submit">Set up two-factor authentication</button>
            </form>
        } else if (!user.TwoFactorEnabled) {
            <p class="muted">Scan this QR code with your authenticator app, or enter the setup key manually.</p>
            <div class="authenticator-qr" aria-label="Authenticator setup QR code">@((MarkupString)qr)</div>
            <label>Setup key<input value="@secret" readonly class="code-input" autocomplete="off" /></label>
            <form action="/auth/2fa/confirm" method="post" data-enhance="false"><AntiforgeryToken />
                <label>Six-digit authenticator code<input name="code" inputmode="numeric" pattern="[0-9 ]{6,7}" autocomplete="one-time-code" required maxlength="7" /></label>
                <button class="button primary" type="submit">Enable two-factor authentication</button>
            </form>
        } else {
            <p class="muted">Your password and an authenticator or recovery code are required at sign-in.</p>
            <p class="mt-3"><strong>@Store.RecoveryCodesRemaining(user.Id)</strong> recovery codes remaining.</p>
            <a class="text-link" href="@Store.LandingPage(user)">Return to workspace</a>
        }
    </section>
    @if (user.TwoFactorEnabled) {
        <section class="panel editor-panel"><h2>Recovery and changes</h2>
            <p class="muted">Generating new recovery codes replaces all previous recovery codes.</p>
            <form action="/auth/2fa/recovery" method="post" data-enhance="false"><AntiforgeryToken />
                <label>Current password<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>
                <label>Fresh authenticator or recovery code<input name="code" autocomplete="one-time-code" required maxlength="30" /></label>
                <button class="button" type="submit">Generate new recovery codes</button>
            </form>
            @if (Store.RequireTwoFactor) { <p class="muted mt-4">Two-factor authentication is required by your instance administrator.</p> }
            else {
                <form action="/auth/2fa/disable" method="post" data-enhance="false" class="mt-6"><AntiforgeryToken />
                    <h3>Disable two-factor authentication</h3>
                    <label>Current password<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>
                    <label>Fresh authenticator or recovery code<input name="code" autocomplete="one-time-code" required maxlength="30" /></label>
                    <button class="button danger" type="submit">Disable two-factor authentication</button>
                </form>
            }
        </section>
    }
    </div>
}
@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name="failed")] public string? Failed { get; set; }
    [SupplyParameterFromQuery(Name="codes")] public string? Receipt { get; set; }
    private UserInfo? user; private string? secret; private string qr=""; private string[]? codes;
    protected override void OnInitialized()
    {
        user=Store.SessionUser(HttpContext.User,allowSetup:true);if(user is null)return;
        if(Receipt is not null && Receipt.Length<=100)codes=Store.TakeRecoveryCodes(user.Id,Receipt);
        if(!user.TwoFactorEnabled && (secret=Store.PendingTwoFactorSecret(user.Id)) is not null)
        {
            var issuer="MeshAll";var uri=$"otpauth://totp/{Uri.EscapeDataString(issuer+":"+user.Name)}?secret={secret}&issuer={issuer}&algorithm=SHA1&digits=6&period=30";
            using var generator=new QRCodeGenerator();using var data=generator.CreateQrCode(uri,QRCodeGenerator.ECCLevel.Q);using var image=new SvgQRCode(data);qr=image.GetGraphic(5);
        }
    }
}
