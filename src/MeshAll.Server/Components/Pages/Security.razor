@page "/account/security"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject Store Store
@using QRCoder

<PageTitle>@Ui["Account security"] · @ProductBrand.Name</PageTitle>
<PageHeader Title="Account security" />

@if (user is not null)
{
    @if (HttpContext.User.HasClaim("setup_required", "true"))
    {
        <Notice Success="This instance requires two-factor authentication. Complete setup to access your workspace." />
    }
    @if (Failed is not null)
    {
        <Notice Error="This security change could not be completed. Check your password and use a fresh authenticator code. Setup expires after ten minutes; codes can only be used once." />
    }
    @if (codes is not null)
    {
        <section class="panel editor-panel">
            <h2>@Ui["Save your recovery codes"]</h2>
            <p class="muted">@Ui["Each code can be used once if you lose access to your authenticator. These codes are shown only once."]</p>
            <ul class="recovery-codes" aria-label="@Ui["Recovery codes"]">
                @foreach (string recoveryCode in codes)
                {
                    <li><code>@recoveryCode</code></li>
                }
            </ul>
            <a class="button primary" href="/account/security">@Ui["I saved my recovery codes"]</a>
        </section>
    }

    <div class="settings-grid">
        <section class="panel editor-panel">
            <h2>@Ui["Two-factor authentication: {0}", Ui[user.TwoFactorEnabled ? "Enabled" : "Not enabled"]]</h2>
            @if (!user.TwoFactorEnabled && secret is null)
            {
                <p class="muted">@Ui["Use an authenticator app such as Microsoft Authenticator, Google Authenticator, or Aegis."]</p>
                <form action="/auth/2fa/setup" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <label>@Ui["Current password"]<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>
                    <button class="button primary" type="submit">@Ui["Set up two-factor authentication"]</button>
                </form>
            }
            else if (!user.TwoFactorEnabled)
            {
                <p class="muted">@Ui["Scan this QR code with your authenticator app, or enter the setup key manually."]</p>
                <div class="authenticator-qr" aria-label="@Ui["Authenticator setup QR code"]">@((MarkupString)qr)</div>
                <label>@Ui["Setup key"]<input value="@secret" readonly class="code-input" autocomplete="off" /></label>
                <form action="/auth/2fa/confirm" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <label>@Ui["Six-digit authenticator code"]<input name="code" inputmode="numeric" pattern="[0-9 ]{6,7}" autocomplete="one-time-code" required maxlength="7" /></label>
                    <button class="button primary" type="submit">@Ui["Enable two-factor authentication"]</button>
                </form>
            }
            else
            {
                <p class="muted">@Ui["Your password and an authenticator or recovery code are required at sign-in."]</p>
                <p>@Ui.Plural(Store.RecoveryCodesRemaining(user.Id), "{0} recovery code remaining.", "{0} recovery codes remaining.")</p>
                <a class="text-link" href="@Store.LandingPage(user)">@Ui["Return to workspace"]</a>
            }
        </section>

        @if (!HttpContext.User.HasClaim("setup_required", "true") && Store.HasPermission(user, Permissions.Rdp))
        {
            <RdpCredentialsSettings @rendermode="InteractiveServer" />
        }

        @if (user.TwoFactorEnabled)
        {
            <section class="panel editor-panel">
                <h2>@Ui["Recovery and changes"]</h2>
                <p class="muted">@Ui["Generating new recovery codes replaces all previous recovery codes."]</p>
                <form action="/auth/2fa/recovery" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <label>@Ui["Current password"]<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>
                    <label>@Ui["Fresh authenticator or recovery code"]<input name="code" autocomplete="one-time-code" required maxlength="30" /></label>
                    <button class="button" type="submit">@Ui["Generate new recovery codes"]</button>
                </form>
                @if (Store.RequireTwoFactor)
                {
                    <p class="muted">@Ui["Two-factor authentication is required by your instance administrator."]</p>
                }
                else
                {
                    <form action="/auth/2fa/disable" method="post" data-enhance="false" class="security-change-form">
                        <AntiforgeryToken />
                        <h3>@Ui["Disable two-factor authentication"]</h3>
                        <label>@Ui["Current password"]<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>
                        <label>@Ui["Fresh authenticator or recovery code"]<input name="code" autocomplete="one-time-code" required maxlength="30" /></label>
                        <button class="button danger" type="submit">@Ui["Disable two-factor authentication"]</button>
                    </form>
                }
            </section>
        }
    </div>
}

@code
{
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "failed")]
    public string? Failed { get; set; }

    [SupplyParameterFromQuery(Name = "codes")]
    public string? Receipt { get; set; }

    private UserInfo? user;
    private string? secret;
    private string qr = "";
    private string[]? codes;
    protected override void OnInitialized()
    {
        user = Store.SessionUser(HttpContext.User, allowSetup: true);
        if (user is null)
        {
            return;
        }

        if (Receipt is not null && Receipt.Length <= 100)
        {
            codes = Store.TakeRecoveryCodes(user.Id, Receipt);
        }

        if (!user.TwoFactorEnabled && (secret = Store.PendingTwoFactorSecret(user.Id))is not null)
        {
            const string issuer = ProductBrand.Name;
            string uri = $"otpauth://totp/{Uri.EscapeDataString(issuer + ":" + user.Name)}?secret={secret}&issuer={issuer}&algorithm=SHA1&digits=6&period=30";
            using QRCodeGenerator generator = new();
            using QRCodeData data = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.Q);
            using SvgQRCode image = new(data);
            qr = image.GetGraphic(5);
        }
    }
}
