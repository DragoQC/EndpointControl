@page "/setup"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@inject Store Store

<PageTitle>@Ui["Set up"] · @ProductBrand.Name</PageTitle>
<section class="auth-card">
    <h1>@Ui["Initial setup"]</h1>
    @if (Store.HasUsers)
    {
        <p>@Ui["Setup is complete."]</p>
        <a class="button primary" href="/login">@Ui["Sign in"]</a>
    }
    else
    {
        <p class="muted">@Ui["Create the first administrator for this workspace."]</p>
        @if (Failed)
        {
            <Notice Error="Setup failed. Check the setup key and use a password of at least 12 characters." />
        }
        <form action="/auth/setup" method="post" data-enhance="false">
            <AntiforgeryToken />
            <label>@Ui["Setup key"]<input name="key" type="password" required autocomplete="off" /><small>@Ui["Find this in the server’s Data/bootstrap.key file."]</small></label>
            <label>@Ui["Your username"]<input name="username" required maxlength="50" autocomplete="username" /></label>
            <label>@Ui["Password"]<input name="password" type="password" required minlength="12" maxlength="256" autocomplete="new-password" /><small>@Ui["At least 12 characters."]</small></label>
            <button type="submit" class="button primary full-width">@Ui["Create workspace"] <Icon Name="arrow" /></button>
        </form>
    }
</section>

@code
{
    [SupplyParameterFromQuery(Name = "failed")]
    public bool Failed { get; set; }
}
