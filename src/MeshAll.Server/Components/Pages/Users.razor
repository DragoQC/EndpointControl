@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inherits PageBase
@inject IJSRuntime JS
<PageTitle>Users · MeshAll</PageTitle>
<div class="page-heading"><div><div class="breadcrumb">Workspace / Users</div><h1>The people behind your fleet.</h1><p class="muted">Give each person the right level of access.</p></div><button class="button primary" @onclick="() => adding = !adding"><Icon Name="plus" />Add user</button></div>
<Notice Error="@Error" Success="@Success" />
@if (adding) { <section class="panel editor-panel"><h2>Add a workspace user</h2><form @onsubmit="Add" @onsubmit:preventDefault><div class="form-grid"><label>Username<input @bind="name" required maxlength="50" autocomplete="off" /></label><label>Role<select @bind="role"><option>Viewer</option><option>Operator</option><option>Admin</option></select></label><label>Initial password<input @bind="password" type="password" required minlength="12" maxlength="256" autocomplete="new-password" /></label></div><p class="muted small-text">Viewers read inventory and activity. Operators also use remote tools and scripts. Administrators manage users, groups, enrollment, and settings. Roles apply to the entire workspace.</p><div class="form-actions"><button type="button" class="button" @onclick="() => adding = false">Cancel</button><button class="button primary" disabled="@Busy">Create user</button></div></form></section> }
@if (resetUser is not null) { <section class="panel editor-panel"><h2>Reset password for @resetUser.Name</h2><form @onsubmit="ResetPassword" @onsubmit:preventDefault><label>New password<input @bind="newPassword" type="password" required minlength="12" maxlength="256" autocomplete="new-password" /></label><div class="form-actions"><button type="button" class="button" @onclick="() => resetUser = null">Cancel</button><button class="button primary" disabled="@Busy">Reset password</button></div><small class="muted">Existing sign-in sessions will be invalidated.</small></form></section> }
<section class="panel"><div class="table-scroll"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var user in users) { <tr><td><div class="user-name"><span class="avatar light">@user.Name[..1].ToUpperInvariant()</span><strong>@user.Name</strong>@if (user.Id == CurrentUser?.Id) { <span class="muted small-text">You</span> }</div></td><td><span class="group-pill">@user.Role</span></td><td><span class="status @(user.Disabled ? "offline" : "online")"><span class="status-dot"></span>@(user.Disabled ? "Disabled" : "Active")</span></td><td><div class="inline-actions"><button class="link-button" @onclick="() => { resetUser = user; newPassword = string.Empty; }">Reset password</button>@if (user.Id != CurrentUser?.Id) { <button class="link-button @(user.Disabled ? "" : "danger-text")" disabled="@Busy" @onclick="() => Toggle(user)">@(user.Disabled ? "Enable" : "Disable")</button> }</div></td></tr> }</tbody></table></div></section>
@code {
    protected override bool AdminPage => true;
    private List<UserInfo> users = []; private bool adding; private string name = "", password = "", role = "Viewer", newPassword = ""; private UserInfo? resetUser;
    protected override Task LoadAsync() { users = Store.Users(); return Task.CompletedTask; }
    private Task Add() => Act(() => { Store.AddUser(name, password, role); Store.Audit(CurrentUser!.Name, "User created", name, role); password = name = ""; adding = false; }, "User created.", true);
    private async Task Toggle(UserInfo u) { if (await JS.InvokeAsync<bool>("confirm", $"{(u.Disabled ? "Enable" : "Disable")} {u.Name}?")) await Act(() => { Store.SetUserDisabled(u.Id, !u.Disabled, CurrentUser!.Id); Store.Audit(CurrentUser.Name, u.Disabled ? "User enabled" : "User disabled", u.Name); }, "User updated.", true); }
    private Task ResetPassword() => Act(() => { Store.ChangePassword(resetUser!.Id, newPassword); Store.Audit(CurrentUser!.Name, "Password reset", resetUser.Name); resetUser = null; newPassword = ""; }, "Password reset. Existing sessions will need to sign in again.", true);
}
