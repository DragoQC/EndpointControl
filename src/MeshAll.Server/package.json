{
  "name": "meshall-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:vendor && npm run build:css",
    "build:vendor": "node Scripts/vendor.mjs",
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/app.css --minify",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/app.css --watch"
  },
  "devDependencies": {
    "@xterm/xterm": "6.0.0",
    "@novnc/novnc": "1.7.0",
    "guacamole-common-js": "1.5.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "overrides": { "@parcel/watcher": "2.6.0" }
}
